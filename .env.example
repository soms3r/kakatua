# Kakatua Environment Variables
# Copy this file to .env and fill in your values.

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kakatua"

# Next.js
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# NextAuth (generate a secret with: openssl rand -base64 32)
NEXTAUTH_SECRET="change-me-to-a-random-secret-at-least-32-chars-long"
NEXTAUTH_URL="http://localhost:3000"

# Resend (https://resend.com) — API key for email-only verification & transactional mail
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
# Verified sender. During Resend onboarding use "onboarding@resend.dev";
# swap to your own domain once verified (e.g. "Kakatua <noreply@kakatua.app>").
RESEND_FROM_EMAIL="Kakatua <onboarding@resend.dev>"
