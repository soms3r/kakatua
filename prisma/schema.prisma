// Prisma schema for Kakatua (prisma/schema.prisma)

// Provider: "sqlite" for local dev, switch to "postgresql" for production deploy.
// Run `prisma migrate deploy` after switching.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. Users Table (authentication core)
model User {
  id                String        @id @default(uuid())
  email             String        @unique
  name              String
  avatarUrl         String?       @map("avatar_url")

  // Legacy JSON-string arrays (kept for backward compatibility)
  nativeLanguages   String        @map("native_languages") @default("[]")
  learningLanguages String        @map("learning_languages") @default("[]")
  interests         String        @default("[]")

  timezoneOffset    Decimal       @map("timezone_offset")
  status            String        @default("active") // active, searching, suspended, banned
  suspensionUntil   DateTime?     @map("suspension_until")
  reportCount       Int           @default(0) @map("report_count")
  ipAddress         String?       @map("ip_address")

  password          String?       // bcrypt-hashed password for credential auth
  isAmbassador      Boolean       @default(false) @map("is_ambassador")
  ambassadorRole    String?       @map("ambassador_role") // GUIDE, MATCHMAKER, CULTURAL_ADVISOR — immutable system bots
  ambassadorBadge   String?       @map("ambassador_badge") // Trust badge text shown next to ambassador name (e.g. "Verified Guide")
  specialtyLanguages String[]     @default([]) @map("specialty_languages") // Languages an ambassador can coach (e.g. ["Bengali", "English"])
  isOnline          Boolean       @default(false) @map("is_online") // Live presence flag for the guardian roster
  countrySlug       String?       @map("country_slug") // URL slug for country detail pages (e.g. "bangladesh", "japan")

  // Profile enrichment fields (legacy, mirrored into Profile)
  bio               String?       // Short personal bio
  traditions        String?       // Cultural traditions or customs
  favoriteFood      String?       @map("favorite_food") // Favourite dish or cuisine
  historyInterest   String?       @map("history_interest") // What history/culture fascinates you

  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  // Relationships
  cultureCard       CultureCard?
  cultureCardLikes  CultureCardLike[]
  missions          Mission[]
  activities        UserActivity[]
  reportsFiled      UserReport[]    @relation("Reporter")
  reportsReceived   UserReport[]    @relation("Reported")
  resolvedReports   UserReport[]    @relation("ResolvedReports")
  guardianRequests  GuardianTicket[] @relation("GuardianRequestor")
  guardianAssignments GuardianTicket[] @relation("GuardianAssignee")

  // Normalized profile architecture
  profile           Profile?
  profileLanguages  UserLanguage[]
  languageGoals     LanguageGoal[]
  matchPreference   MatchPreference?
  userInterests     UserInterest[]
  availability      Availability[]
  privacySettings   PrivacySettings?
  verification      Verification?
  blocks            UserBlock[]     @relation("Blocker")
  blockedBy         UserBlock[]     @relation("Blocked")

  @@map("users")
}

// 2. Culture Cards Table (1:1 with User)
model CultureCard {
  id              String            @id @default(uuid())
  userId          String            @unique @map("user_id")
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  data            String            // JSON stored as text in SQLite
  detailedContent String?           @map("detailed_content") // Extended cultural library JSON (languageInfo, rituals, cuisine, history, etiquette)
  loveCount       Int               @default(0) @map("love_count")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  // Relationships
  likes           CultureCardLike[]

  @@map("culture_cards")
}

// 7. Culture Card Likes (unique user-card love reactions)
model CultureCardLike {
  id            String      @id @default(uuid())
  userId        String      @map("user_id")
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  cultureCardId String      @map("culture_card_id")
  cultureCard   CultureCard @relation(fields: [cultureCardId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now()) @map("created_at")

  @@unique([userId, cultureCardId])
  @@map("culture_card_likes")
}

// 3. Missions Table (per-user, normalized — prebuilt, auto-generated, and custom)
model Mission {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  description   String
  category      String    @default("DAILY") // DAILY, CONVERSATION, GOAL
  progress      Int       @default(0)
  target        Int       @default(100)
  status        String    @default("PENDING") // PENDING, COMPLETED
  expReward     Int       @default(0) @map("exp_reward")
  rewardClaimed Boolean   @default(false) @map("reward_claimed")
  isPrebuilt    Boolean   @default(false) @map("is_prebuilt")
  source        String    @default("CUSTOM") // PREBUILT, AUTO, CUSTOM
  completedAt   DateTime? @map("completed_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("missions")
}

// 5. User Reports Table (spam-blocked audit trail)
model UserReport {
  id         String   @id @default(uuid())
  reporterId String   @map("reporter_id")
  reporter   User     @relation("Reporter", fields: [reporterId], references: [id], onDelete: Restrict)
  reportedId String   @map("reported_id")
  reported   User     @relation("Reported", fields: [reportedId], references: [id], onDelete: Cascade)
  reason     String
  status     String   @default("PENDING") // PENDING, ACTIONED, RESOLVED, DISMISSED
  resolution String?  // Guardian's note on what was done
  resolvedById String? @map("resolved_by_id")
  resolvedBy User?    @relation("ResolvedReports", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt DateTime? @map("resolved_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([reporterId, reportedId])
  @@index([status])
  @@map("user_reports")
}

// ─── Guardian Support System ──────────────────────────────────────────────────
// Tickets raised by community members for an ambassador ("guardian") to answer:
// GUIDANCE (life/culture advice), PRACTICE_SESSION (language practice), SAFETY_FLAG.
model GuardianTicket {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation("GuardianRequestor", fields: [userId], references: [id], onDelete: Cascade)
  guardianId String?  @map("guardian_id")
  guardian   User?    @relation("GuardianAssignee", fields: [guardianId], references: [id], onDelete: SetNull)
  type       String   // GUIDANCE, PRACTICE_SESSION, SAFETY_FLAG
  subject    String
  message    String
  status     String   @default("OPEN") // OPEN, ACCEPTED, CLOSED
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  acceptedAt DateTime? @map("accepted_at")
  resolvedAt DateTime? @map("resolved_at")
  resolution String?

  @@index([userId])
  @@index([guardianId])
  @@index([status])
  @@map("guardian_tickets")
}

// 6. Feedbacks Table (Flock Feedback system)
model Feedback {
  id             String   @id @default(uuid())
  userId         String?  @map("user_id")
  message        String
  category       String   // Bug, Idea, FeatureRequest, Other
  contactInfo    String?  @map("contact_info")
  status         String   @default("New") // New, Reviewing, Resolved
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("feedbacks")
}

// ─── Normalized Profile Architecture ──────────────────────────────────────────

// 8. Profiles Table (1:1 with User — extended public profile)
model Profile {
  id                String    @id @default(uuid())
  userId            String    @unique @map("user_id")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  username          String?   @unique
  displayName       String?   @map("display_name")
  profilePhoto      String?   @map("profile_photo")
  bio               String?
  dateOfBirth       DateTime? @map("date_of_birth")
  gender            String?
  country           String?
  city              String?
  timezone          String?
  nativeLanguage    String?   @map("native_language")
  interfaceLanguage String?   @map("interface_language")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@map("profiles")
}

// 9. Languages Table (master data)
model Language {
  id            String         @id @default(uuid())
  code          String         @unique
  name          String
  flagEmoji     String?        @map("flag_emoji")
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at")

  userLanguages UserLanguage[]
  languageGoals LanguageGoal[]

  @@map("languages")
}

// 10. User Languages Table (native vs. learning with proficiency)
model UserLanguage {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  languageId String   @map("language_id")
  language   Language @relation(fields: [languageId], references: [id], onDelete: Cascade)
  type       String   // NATIVE or LEARNING
  proficiency String? // A1..C2 or BEGINNER..FLUENT
  isPrimary  Boolean  @default(false) @map("is_primary")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([userId, languageId, type])
  @@index([userId])
  @@index([languageId])
  @@map("user_languages")
}

// 11. Language Goals Table (learning goals tracking)
model LanguageGoal {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  languageId  String?   @map("language_id")
  language    Language? @relation(fields: [languageId], references: [id], onDelete: SetNull)
  goalType    String    // FLUENCY, CONVERSATION, TRAVEL, CAREER, TEST_PREP, CULTURE
  targetLevel String?
  targetDate  DateTime? @map("target_date")
  status      String    @default("ACTIVE") // ACTIVE, COMPLETED, DROPPED
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([userId])
  @@map("language_goals")
}

// 12. Match Preferences Table (1:1 with User)
model MatchPreference {
  id                     String   @id @default(uuid())
  userId                 String   @unique @map("user_id")
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  seeking                String?  // LANGUAGE_PARTNER, FRIEND, MENTOR, TUTOR
  partnerGenderPreference String? @map("partner_gender_preference")
  partnerAgeMin          Int?     @map("partner_age_min")
  partnerAgeMax          Int?     @map("partner_age_max")
  callPreference         String?  @map("call_preference") // VIDEO, AUDIO, TEXT
  conversationTopics     String?  // JSON array string
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  @@map("match_preferences")
}

// 13. Interests Table (master data)
model Interest {
  id            String          @id @default(uuid())
  name          String          @unique
  category      String?
  isActive      Boolean         @default(true) @map("is_active")
  createdAt     DateTime        @default(now()) @map("created_at")

  userInterests UserInterest[]

  @@map("interests")
}

// 14. User Interests Table
model UserInterest {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interestId String   @map("interest_id")
  interest   Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([userId, interestId])
  @@index([userId])
  @@map("user_interests")
}

// 15. Availability Table (weekly schedule)
model Availability {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayOfWeek Int      @map("day_of_week") // 0=Sunday ... 6=Saturday
  startTime String   @map("start_time")  // "HH:MM" 24h
  endTime   String   @map("end_time")
  timezone  String?
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, dayOfWeek, startTime, endTime])
  @@index([userId])
  @@map("availability")
}

// 16. Privacy Settings Table (1:1 with User)
model PrivacySettings {
  id               String   @id @default(uuid())
  userId           String   @unique @map("user_id")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  showProfile      Boolean  @default(true) @map("show_profile")
  showOnlineStatus Boolean  @default(true) @map("show_online_status")
  showLastActive   Boolean  @default(true) @map("show_last_active")
  showEmail        Boolean  @default(false) @map("show_email")
  showAge          Boolean  @default(true) @map("show_age")
  showLocation     Boolean  @default(true) @map("show_location")
  allowDMs         Boolean  @default(true) @map("allow_dms")
  allowVideoCalls  Boolean  @default(true) @map("allow_video_calls")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("privacy_settings")
}

// 17. Verification Table (1:1 with User)
model Verification {
  id               String    @id @default(uuid())
  userId           String    @unique @map("user_id")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailVerified    Boolean   @default(false) @map("email_verified")
  phoneVerified    Boolean   @default(false) @map("phone_verified")
  photoVerified    Boolean   @default(false) @map("photo_verified")
  identityVerified Boolean   @default(false) @map("identity_verified")
  method           String?   // EMAIL, PHONE, SOCIAL, DOCUMENT
  verifiedAt       DateTime? @map("verified_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@map("verification")
}

// 18. User Blocks Table
model UserBlock {
  id        String   @id @default(uuid())
  blockerId String   @map("blocker_id")
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String   @map("blocked_id")
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_blocks")
}

// 19. User Activity Log Table (per-user timeline & analytics)
model UserActivity {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  actionType  String   @map("action_type") // VIDEO_MATCH_COMPLETED, MISSION_COMPLETED, PROFILE_UPDATED, FEEDBACK_SUBMITTED, MISSION_CREATED
  title       String
  description String?
  metadata    Json?    // extra context (partnerId, compatibilityScore, minutes, expReward, ...)
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("user_activities")
}
